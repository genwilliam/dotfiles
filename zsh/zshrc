# Interactive shell configuration (starship flavour).
#
# This file is an *orchestrator*: it picks the cache locations, loads the
# zshrc.d modules in the documented order, and bootstraps Oh My Zsh.
#
# PATH is owned by .zprofile -- do not add PATH entries here.
#
# There are two prompt flavours, and exactly one of them is linked to ~/.zshrc
# by install.sh (--prompt starship | p10k):
#   * zsh/zshrc   (this file) -- starship, config in config/starship.toml
#   * p10k/zshrc              -- powerlevel10k, config in p10k/p10k.zsh
# Both source the shared ~/.zshrc.d modules, so aliases/completion/tools stay
# identical regardless of the prompt.

export ZSH="$HOME/.oh-my-zsh"
export ZSHRC_D="$HOME/.zshrc.d"

# Which prompt is active; the shared modules read this (see zshrc.d/tools.zsh).
# The p10k wrapper (p10k/zshrc) presets it to "p10k" before sourcing this file,
# so only default it here. Switching flavour takes effect in a new shell.
: "${ZSH_PROMPT_FLAVOR:=starship}"
export ZSH_PROMPT_FLAVOR

# Starship renders the prompt, so no Oh My Zsh theme is loaded. The p10k
# wrapper presets ZSH_THEME; keep whatever it set.
: "${ZSH_THEME:=}"

DISABLE_AUTO_UPDATE="true"
ZSH_DISABLE_COMPFIX="true"

: "${XDG_CACHE_HOME:=$HOME/.cache}"

export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-$XDG_CACHE_HOME/oh-my-zsh}"
export ZSH_COMPDUMP="${ZSH_COMPDUMP:-$XDG_CACHE_HOME/zsh/.zcompdump-${HOST%%.*}-${ZSH_VERSION}}"

mkdir -p "$ZSH_CACHE_DIR" "${ZSH_COMPDUMP:h}"

# Keep path/fpath unique so that re-sourcing ~/.zshrc does not grow them and
# force compinit to rebuild the completion dump.
typeset -gU path fpath

# Optional startup profiling, see zsh/zshrc.d/README.md:
#   ZSH_STARTUP_PROFILE=1 zsh -i -c exit
# Prints one "zsh-startup <ms> <module>" line per sourced module, on stderr.
typeset -g _zsh_profile=0
if [[ -n "${ZSH_STARTUP_PROFILE:-}" ]] && zmodload zsh/datetime 2>/dev/null; then
  _zsh_profile=1
fi

source_if_readable() {
  local _rc=0

  if [[ ! -r "$1" ]]; then
    return 0
  fi

  if (( _zsh_profile )); then
    local _t0=$EPOCHREALTIME
    source "$1" || _rc=$?
    printf 'zsh-startup %6.1fms %s\n' \
      $(( (EPOCHREALTIME - _t0) * 1000 )) "${1:t}" >&2
    return $_rc
  fi

  source "$1" || _rc=$?
  return $_rc
}

source_modules() {
  local file

  for file in "$@"; do
    source_if_readable "$ZSHRC_D/$file"
  done
}

# Pre-Oh-My-Zsh: environment variables and the plugins=(...) list.
source_modules \
  env.zsh \
  env.local.zsh \
  plugins.zsh

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 "zsh: Oh My Zsh not found at $ZSH/oh-my-zsh.sh -- run ./install.sh, or set ZSH to your installation"
fi

# Post-Oh-My-Zsh: aliases, completion policy, tool initialisation.
source_modules \
  aliases.zsh \
  completion.zsh \
  tools.zsh
