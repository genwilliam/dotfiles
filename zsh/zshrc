# ~/.zshrc

# Oh My Zsh 安装路径
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
DISABLE_AUTO_UPDATE="true"

# 先加载环境变量 / PATH 等（不依赖 OMZ)
[[ -r ~/.zshrc.d/env.zsh ]] && source ~/.zshrc.d/env.zsh

# 先定义 OMZ 插件列表（必须在 oh-my-zsh.sh 之前)
[[ -r ~/.zshrc.d/plugins.zsh ]] && source ~/.zshrc.d/plugins.zsh

# 加载 Oh My Zsh（会读取 plugins 数组)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# 其余模块按固定顺序加载（避免文件名排序导致行为漂移）
for f in aliases.zsh completion.zsh tools.zsh; do
  [[ -r "$HOME/.zshrc.d/$f" ]] && source "$HOME/.zshrc.d/$f"
done

# 其他自定义模块（可选）：跳过已加载模块，保持可扩展
# (N) 表示无匹配时返回空，避免 no matches found
for f in ~/.zshrc.d/*.zsh(N); do
  case "$f" in
    "$HOME/.zshrc.d/env.zsh"|"$HOME/.zshrc.d/plugins.zsh"|"$HOME/.zshrc.d/aliases.zsh"|"$HOME/.zshrc.d/completion.zsh"|"$HOME/.zshrc.d/tools.zsh") continue ;;
  esac
  [[ -r "$f" ]] && source "$f"
done

# Prompt / tools 初始化统一在 zshrc.d/tools.zsh

