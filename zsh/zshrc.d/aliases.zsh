# git begin
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
# git end

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~" # `cd` is probably faster to type though
alias -- -="cd -"
alias ll='ls -lh'
alias la='ls -a'

