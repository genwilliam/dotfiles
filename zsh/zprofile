# login shell configuration
# only executed for login shells
# recommended to set environment variables, PATH, etc. here
#
# PATH ownership: this file is responsible for PATH. .zshrc orchestrates
# interactive setup and must not add PATH entries of its own.

typeset -U path PATH

prepend_path_if_exists() {
  [[ -d "$1" ]] && path=("$1" $path)
}

prepend_path_if_exists "$HOME/.local/bin"
prepend_path_if_exists "$HOME/Library/pnpm"

if [[ "$OSTYPE" == darwin* ]]; then
  prepend_path_if_exists /opt/homebrew/bin
  prepend_path_if_exists /usr/local/bin
elif [[ "$OSTYPE" == linux* ]]; then
  prepend_path_if_exists /usr/local/bin
fi

unfunction prepend_path_if_exists
export PATH

# Homebrew's shellenv prepends its own bin/sbin and must run before the
# user-specific tool directories below, so that those keep priority.
if command -v brew >/dev/null 2>&1; then
  eval "$("$(command -v brew)" shellenv)"
fi

# User-tool bin directories, added last so they take priority. Guarded by an
# existence check: these tools are optional and not present on every machine.
# Keep this list $HOME-relative so the file stays portable.
typeset -a _extra_user_bins=(
  "$HOME/.openclaw/bin"
)

typeset _extra_bin
for _extra_bin in "${_extra_user_bins[@]}"; do
  [[ -d "$_extra_bin" ]] && path=("$_extra_bin" $path)
done

unset _extra_user_bins _extra_bin
export PATH
