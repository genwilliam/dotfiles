#!/usr/bin/env bash

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# macOS System Settings Automation Script - Based on Current User Preferences
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Request administrator password before running
sudo -v

# Hot Corners
# Top-left corner -> Mission Control (2)
defaults write com.apple.dock wvous-tl-corner -int 2
defaults write com.apple.dock wvous-tl-modifier -int 0

# Top-right corner -> Start Screen Saver (5)
defaults write com.apple.dock wvous-tr-corner -int 5
defaults write com.apple.dock wvous-tr-modifier -int 0

# Bottom-left corner -> Show Desktop (4)
defaults write com.apple.dock wvous-bl-corner -int 4
defaults write com.apple.dock wvous-bl-modifier -int 0

# Bottom-right corner -> Lock Screen (13)
defaults write com.apple.dock wvous-br-corner -int 13
defaults write com.apple.dock wvous-br-modifier -int 0


# Trackpad & Mouse
# Tap to click
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

# Three finger drag
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true

# Secondary click
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadRightClick -bool true
defaults write com.apple.AppleMultitouchTrackpad TrackpadRightClick -bool true

# Finder
# Show Path Bar
defaults write com.apple.finder ShowPathbar -bool true

# Search in the current folder by default (SCcf)
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"


# Dock
# set the icon size of Dock items to 63 pixels
defaults write com.apple.dock tilesize -int 63


# begin
echo "Refreshing system settings..."
for app in "Finder" "Dock" "SystemUIServer"; do
    killall "$app" &> /dev/null
done

echo "Configuration complete! Some settings may require a restart to take effect."