#!/usr/bin/env bash
#
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# macOS System Settings Automation Script - Based on Current User Preferences
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#
# NOT run by install.sh. Run it by hand: it changes system-wide state.
#
# What it changes:
#   * `defaults write` preferences for the Dock, Finder, keyboard, trackpad,
#     menu bar, Mail, Mission Control, screenshots, fonts and the login window
#   * `chflags hidden ~/Library` -- hides your Library folder in Finder
#   * `hidutil` CapsLock delay override (cleared again on the next reboot)
#   * flushes the DNS cache and switches the application firewall ON (sudo)
#   * removes Google's software updater if it is installed -- deletes files
#   * restarts Finder, Dock and SystemUIServer (closes any open Finder windows)
#
# Requirements: macOS, an administrator account (it asks for sudo once).
# Risks: preferences have no undo, the firewall is turned on, Google's updater
#        is removed, and the Finder/Dock restart. Read the file before running.
#          Individual `defaults write` failures are not fatal, by design: the
#        script applies the whole list rather than stopping at the first
#        preference the current macOS version no longer supports.
#
# Usage: ./macos [-n|--dry-run] [-y|--yes] [-h|--help]

set -uo pipefail

ASSUME_YES=0
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage: ./macos [options]

Applies the personal macOS system preferences listed in this file.

Options:
  -n, --dry-run  Print every command instead of running it
  -y, --yes      Do not ask for confirmation
  -h, --help     Show this help message

This script is not run by install.sh. See README.md for the full list of
changes and the associated risks.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1; shift ;;
    -y|--yes)     ASSUME_YES=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    *) printf 'Unknown option: %s (try --help)\n' "$1" >&2; exit 2 ;;
  esac
done

if [[ "$DRY_RUN" -eq 1 ]]; then
  # Preview mode: shadow the tools this script drives with printers, so the
  # whole file can be reviewed without changing anything. `killall` is
  # deliberately NOT shadowed here: shell functions cannot be invoked through
  # `sudo`, and the non-sudo restart loop below handles its own dry-run.
  defaults() { printf '  [dry-run] defaults'; printf ' %s' "$@"; printf '\n'; }
  sudo()     { printf '  [dry-run] sudo';     printf ' %s' "$@"; printf '\n'; }
  hidutil()  { printf '  [dry-run] hidutil';  printf ' %s' "$@"; printf '\n'; }
  chflags()  { printf '  [dry-run] chflags';  printf ' %s' "$@"; printf '\n'; }
fi

if [[ "$DRY_RUN" -eq 0 ]]; then
  if [[ "$ASSUME_YES" -eq 0 && -t 0 ]]; then
    cat <<'EOF'
This will change system-wide macOS settings, switch the application firewall
ON, remove Google's software updater if present, and restart Finder/Dock.
Continue? [y/N]: 
EOF
    read -r reply || true
    case "$reply" in
      [Yy]) ;;
      *) printf 'Aborted; nothing was changed.\n'; exit 0 ;;
    esac
  fi

  ############################## Request administrator password before running
  sudo -v
fi

############################### Hot Corners ###############################
# Top-left corner -> Mission Control (2)
defaults write com.apple.dock wvous-tl-corner -int 2
defaults write com.apple.dock wvous-tl-modifier -int 0

# Top-right corner -> Start Screen Saver (5)
defaults write com.apple.dock wvous-tr-corner -int 5
defaults write com.apple.dock wvous-tr-modifier -int 0

# Bottom-left corner -> Show Desktop (4)
defaults write com.apple.dock wvous-bl-corner -int 4
defaults write com.apple.dock wvous-bl-modifier -int 0

# Bottom-right corner -> Lock Screen (13)
defaults write com.apple.dock wvous-br-corner -int 13
defaults write com.apple.dock wvous-br-modifier -int 0


############################### Trackpad & Mouse ###############################
# Tap to click
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

# Three finger drag(Dragging with three finger drag)
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true

# Secondary click
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadRightClick -bool true
defaults write com.apple.AppleMultitouchTrackpad TrackpadRightClick -bool true

# open mouse acceleration(default is false, false is opened, true is closed)
# Set movement speed of the mouse cursor: https://macos-defaults.com/mouse/scaling.html
defaults write NSGlobalDomain com.apple.mouse.linear -bool "false"

# Choose whether to enable moving focus with Tab and Shift Tab.(0, 2, 3)
defaults write NSGlobalDomain AppleKeyboardUIMode -int "3"

# Enable "group windows by application" in Mission Control (default is false)
defaults write com.apple.dock "expose-group-apps" -bool "true"

############################## Finder ###############################
# Show Path Bar
defaults write com.apple.finder ShowPathbar -bool true

# Set the default view style for folders with no custom settings(https://macos-defaults.com/finder/fxpreferredviewstyle.html)
defaults write com.apple.finder "FXPreferredViewStyle" -string "icnv"

# setting the default search scope to "current folder" (SCcf) instead of "This Mac" (SCev)
# more: https://macos-defaults.com/finder/fxdefaultsearchscope.html
defaults write com.apple.finder "FXDefaultSearchScope" -string "SCcf"

# 30days after which the items in the Trash are automatically deleted(default is false)
defaults write com.apple.finder "FXRemoveOldTrashItems" -bool "true"

# Show warning before changing an extension(true by default)
# when value is false, it will not show the warning when changing a file extension, which can lead to accidental changes and potential issues with file compatibility. It's generally recommended to keep this setting enabled to avoid unintended consequences.
defaults write com.apple.finder "FXEnableExtensionChangeWarning" -bool "true"

# Show hard disks on desktop(default is false)
defaults write com.apple.finder "ShowHardDrivesOnDesktop" -bool "false"

# Hide external disks on desktop(default is true)
defaults write com.apple.finder "ShowExternalHardDrivesOnDesktop" -bool "true"

# setting the default language to English (en) for the Finder application
defaults write com.apple.finder AppleLanguages -array en

# Hide the ~/Library folder in Finder by default (true by default)
chflags hidden ~/Library


############################### Dock ###############################
# set the icon size of Dock items to 63 pixels
# defaults write com.apple.dock tilesize -int 63
defaults delete com.apple.dock "tilesize" # default settings

# Hidden apps use transparent icons
defaults write com.apple.dock showhidden -bool true

# Put the Dock on the bottom of the screen
defaults write com.apple.dock "orientation" -string "bottom"

# when auto hiding the dock is open, make the animation 2 seconds(default: 0.5, close: 0)
# defaults write com.apple.dock "autohide-time-modifier" -float "2"

# Show recent usage history in Dock
defaults write com.apple.dock "show-recents" -bool "true" # default
# defaults write com.apple.dock "show-recents" -bool "false"

# Minimize animation effect (https://macos-defaults.com/dock/mineffect.html)
defaults write com.apple.dock "mineffect" -string "genie" # default
# defaults write com.apple.dock "mineffect" -string "scale"
# defaults write com.apple.dock "mineffect" -string "suck"

####### Show only apps that are open in the Dock(https://macos-defaults.com/dock/static-only.html)

# Scroll up on a Dock icon to show all Space's opened windows for an app, or open stack.default is "false"
# lock https://macos-defaults.com/dock/scroll-to-open.html
defaults write com.apple.dock "scroll-to-open" -bool "true"

# enable dock magnification, and set the magnified icon size to 67 pixels(default is false, default magnified size is 128)
defaults write com.apple.dock magnification -bool true
defaults write com.apple.dock largesize -int 67

# Tuck the minimized window into the application icon
defaults write com.apple.dock minimize-to-application -bool true

# Show indicator lights for open applications in the Dock (default is true)
defaults write com.apple.finder _FXSortFoldersFirst -bool true

# Prevent the creation of .DS_Store files on network or USB volumes (default is false)
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Set the default location for new Finder windows to the home directory (PfHm)
defaults write com.apple.finder NewWindowTarget -string "PfHm"
defaults write com.apple.finder NewWindowTargetPath -string "file://${HOME}/"

# Show external hard drives on the desktop (default is false)
defaults write com.apple.finder ShowExternalHardDrivesOnDesktop -bool true

# Show all filename extensions (default is false)
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Prevent the creation of .DS_Store files on network volumes (default is false)
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true

# Disable apple personalized advertising (default is true)
defaults write com.apple.AdLib allowApplePersonalizedAdvertising -bool false

# Silently handle application crash reports
# defaults write com.apple.CrashReporter DialogType -string "none"

# Disable Spotlight Suggestions in Look Up (default is true)
defaults write com.apple.lookup.shared LookupSuggestionsDisabled -bool true

# Disable Siri (default is true)
defaults write com.apple.assistant.support "Assistant Enabled" -bool false

# New documents are saved by default on Mac instead of iCloud
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

# Mission Control groups Windows by application
defaults write com.apple.dock expose-group-apps -bool true

# Show the day of the week in the menu bar clock
defaults write com.apple.menuextra.clock ShowDayOfWeek -bool true

################################################## font #####################################
defaults write -g CGFontRenderingFontSmoothingDisabled -bool false # Subpixel Anti-Aliasing (Font Smoothing)


######################################### other #############################
# Show Attachments as Icons
defaults write com.apple.mail DisableInlineAttachmentViewing -bool true

# disable CapsLockDelay functionality
hidutil property --set '{"CapsLockDelayOverride":0}'

# clean dns cache
sudo dscacheutil -flushcache && \
sudo killall -HUP mDNSResponder

# Firewall Service
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on

# By default, pressing a function key will perform the special feature printed on that key.
defaults write NSGlobalDomain com.apple.keyboard.fnState -bool false
# F1, F2, etc. behave as standard function keys. Press the fn key to use the special features printed on the key.
# defaults write NSGlobalDomain com.apple.keyboard.fnState -bool true

# Turn on the language indicator while switching input sources.
defaults write kCFPreferencesAnyApplication TSMLanguageIndicatorEnabled -bool "true"

# Do reorder Spaces based on most recent use(default)
defaults write com.apple.dock "mru-spaces" -bool "true"

############################### delete google update ################
# Removes Google's silent auto-updater. This DELETES files, and it is only
# meaningful if Google software (e.g. Chrome) is installed.
GOOGLE_UPDATER="$HOME/Library/Google/GoogleSoftwareUpdate/GoogleSoftwareUpdate.bundle/Contents/Resources/ksinstall"
if [[ -x "$GOOGLE_UPDATER" ]]; then
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  [dry-run] %s --nuke\n' "$GOOGLE_UPDATER"
  else
    "$GOOGLE_UPDATER" --nuke
  fi
else
  printf 'Google software updater not installed; skipping.\n'
fi

# begin
echo "Refreshing system settings..."
for app in "Finder" "Dock" "SystemUIServer"; do
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '  [dry-run] killall %s\n' "$app"
    else
        killall "$app" &> /dev/null
    fi
done

if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "Dry run complete: nothing was changed."
else
    echo "Configuration complete! Some settings may require a restart to take effect."
fi
