# Interactive shell configuration (powerlevel10k flavour).
#
# This is a thin *overlay*: it only handles what differs from the starship
# flavour and then reuses the shared orchestrator in zsh/zshrc. Aliases,
# completion policy, tool initialisation, the zshrc.d module order and the
# completion-cache handling therefore stay identical across both flavours.
#
# install.sh links this file to ~/.zshrc when you pass --prompt p10k.

# 1) powerlevel10k instant prompt must be initialised before anything prints.
#    Keep this block at the very top of the file.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# 2) Tell the shared modules and Oh My Zsh which prompt to use.
typeset -gx ZSH_PROMPT_FLAVOR="p10k"
typeset -g ZSH_THEME="powerlevel10k/powerlevel10k"

# 3) Reuse the shared orchestrator. `%N` is the name this file was sourced as
#    (normally the ~/.zshrc symlink) and `:A` resolves that symlink, so the
#    repository root is found without hard-coding any path.
typeset -g _p10k_self="${${(%):-%N}:A}"
typeset -g _p10k_orchestrator="${_p10k_self:h:h}/zsh/zshrc"

if [[ -r "$_p10k_orchestrator" ]]; then
  source "$_p10k_orchestrator"
else
  print -u2 "zsh: shared orchestrator not found at $_p10k_orchestrator"
  print -u2 "zsh: is ~/.zshrc still the symlink created by ./install.sh --prompt p10k ?"
fi

unset _p10k_self _p10k_orchestrator

# 4) The prompt configuration generated by `p10k configure`.
#    Loaded after Oh My Zsh has sourced the powerlevel10k theme.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
